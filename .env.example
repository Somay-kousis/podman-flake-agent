# Copy to .env (gitignored) and fill in what you need. Nothing here is
# required to run the offline test suite or --backend ollama.

# Read-only, public-repositories-only, fine-grained PAT. Raises the GitHub
# API rate limit from 60/hr to 5,000/hr. See README.md "With a token".
GITHUB_TOKEN = github_pat_your_token_here

# Only needed for `flakeagent.agent --backend api` -- the tool-calling arm in
# flakeagent/classify.py's AnthropicBackend. Also needs `pip install anthropic`,
# which nothing else in this package requires. See docs/RESULTS.md for why
# this arm is wired but unmeasured, and the exact command to change that.
# ANTHROPIC_API_KEY = your_key_here
